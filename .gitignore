# 产物目录：可全量重建，不入库（方案 §4.1）
workspace/

# 本地模型权重与外部源码（体积大，按需重新下载）
.models/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 密钥与环境（DeepSeek key 只从环境变量读，绝不落盘/入库）
.env
.env.*
!.env.example

# 本地临时
*.log
server.pid
.DS_Store
.playwright-mcp/

# 云端迁移数据（从外部只读源同步，不入库）
data/
# 例外：趋势快照是约 1 MB 的生产资产，必须随代码部署
!hotspot/data/
!hotspot/data/topic_snapshot_v1.json.gz

# dasc 运行时产物：LLM 响应缓存 + 出境审计日志（本机可重建，v 别入库）
# 406 个 JSON 会把 grep/搜索淹掉，clone 也多 2 MB
hotspot/vendor/dasc/_out/
